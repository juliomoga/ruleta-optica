{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/api/((?!logo).*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(pantalla|tablet|admin)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
