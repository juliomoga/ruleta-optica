# Solo para probar la ruleta en tu ordenador (npm run local). En Vercel no hace falta: la base la
# crea el botón de instalar (Neon) y la clave se pide al instalar. Copia este archivo como .env.

# Conexión a un Postgres (Neon: Vercel → Storage → tu base → .env.local → DATABASE_URL)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clave para entrar en /admin (invéntatela, larga)
CLAVE_PANEL=una-clave-larga-que-solo-sepas-tu

# Opcional: correo por variables (si no, se configura desde el panel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tuoptica@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# MAIL_FROM=Óptica Ejemplo <tuoptica@gmail.com>
